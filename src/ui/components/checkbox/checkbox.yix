//! Checkbox view. Styles in styles.yss (CheckboxParts), tests in mod.zig.
const ui = @import("../../ui.zig");
const S = @import("styles.yss");

/// Checkbox: W.Checkbox(.{ .label = "Agree", .checked = agree }).
/// checked is controlled value: pass bool = component self-holds, pass signal = interaction writes
/// directly, ui.split = parent decides;
/// on_change only reports settled value. indeterminate read-only (controlled by parent, parent
/// decides after click whether to clear).
/// Disabled suppresses click / space / enter, exits Tab order.
pub fn Checkbox(
    checked: Model(bool) = false,
    indeterminate: bool = false,
    label: Text = "",
    disabled: bool = false,
    focusRing: ui.FocusRingConfig = .{},
    onChange: ?Handler(bool) = null,
    checkIconAsset: ?ui.SvgAsset = null,
) View {
    const on = computed(checked or indeterminate);
    const mixed = computed(indeterminate and !checked);
    return (
        <row
            style={S.CheckboxParts.slot(.root, .{ .disabled = disabled })}
            tag={.button}
            focusable={!disabled}
            focusRing={focusRing}
            a11y={.{ .role = .checkbox, .checked = checked, .indeterminate = mixed, .disabled = disabled, .label = label }}
            onClick={if (!disabled) checked = !checked}
        >
            <box style={S.CheckboxParts.slot(.box, .{ .on = on, .disabled = disabled })}>
                <icon style={S.CheckboxParts.slot(.check, .{ .shown = checked, .disabled = disabled })} src={checkIconAsset orelse ui.assets.common.checkbox_check} />
                <box style={S.CheckboxParts.slot(.indet, .{ .shown = mixed })}>
                    <icon style={S.CheckboxParts.slot(.check, .{ .shown = true, .disabled = disabled })} src={ui.assets.common.checkbox_mixed} />
                </box>
            </box>
            {if (label.len != 0) <text style={S.CheckboxParts.slot(.label, .{ .disabled = disabled })}>{label}</text>}
        </row>
    );
}
