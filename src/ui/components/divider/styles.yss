//! Divider styling. Geometry (direction, weight, dashed segment length and gap, margin,
//! color override) from component params; default color from `border-strong` token, label
//! text from `fg-secondary`, follows theme. View in divider.yix; public types like
//! DividerOrientation in mod.zig.
const ui = @import("../../ui.zig");
const mod = @import("mod.zig");

/// Divider styles: solid / dashed dotted (fixed segments in row, container clips excess)
/// / with label (label at left/center/right).
pub const Kind = enum { solid, patterned, label_left, label_center, label_right };
/// Root node: solid is the line itself; dashed/dotted is container of clipped segments;
/// with label is "line + label + line" row. Margin: horizontal line top/bottom gaps,
/// vertical line left/right gaps; with label becomes top/bottom padding.
style root(
  $kind: Kind,
  $orientation: mod.DividerOrientation,
  $thickness: f32,
  $color: ?ui.Color,
  $spacing: mod.DividerSpacing,
  $dash_gap: f32,
) {
  when $kind in (solid, patterned) & $orientation = horizontal { width: grow; height: $thickness; margin: {$spacing.value()} 0; }
  when $kind in (solid, patterned) & $orientation = vertical { width: $thickness; height: grow; align-self: stretch; margin: 0 {$spacing.value()}; }
  when $kind = solid { background: $color ?? border-strong; }
  when $kind = patterned { align-items: center; gap: $dash_gap; overflow-hidden: true; }
  when $kind = patterned & $orientation = horizontal { direction: row; }
  when $kind = patterned & $orientation = vertical { direction: column; }
  when $kind in (label_left, label_center, label_right) { width: grow; direction: row; align-items: center; gap: space300; padding: {$spacing.value()} 0; }
}

/// Dashed / dotted segment (dotted uses circles with side=weight); doesn't flex-shrink or
/// compresses to 0.
style dash($orientation: mod.DividerOrientation, $variant: mod.DividerVariant, $thickness: f32, $length: f32, $color: ?ui.Color) {
  background: $color ?? border-strong;
  flex-shrink: 0;
  when $orientation = horizontal { width: $length; height: $thickness; }
  when $orientation = vertical { width: $thickness; height: $length; }
  when $variant = dotted { corner-radius: {$thickness / 2}; }
  when $variant = dotted & $orientation = horizontal { width: $thickness; }
  when $variant = dotted & $orientation = vertical { height: $thickness; }
}

/// Line segments on label sides, split remaining width equally
style label_line($thickness: f32, $color: ?ui.Color) { width: grow; height: $thickness; background: $color ?? border-strong; flex: 1; }

style label_text { color: fg-secondary; font-size: sm; }

/// Dashed segment count: enough to cover common widths, excess clipped by container
pub const dash_count = 128;
