//! Button: an action control composed on ControlShell. The shell owns the frame, tone, geometry
//! (glyph icon fit) and every interaction state; Button fills its icon slot (svg glyph / texture /
//! loading ring) and content slot (label), and merges its root style into the tone. Label, glyph
//! and ring inherit the shell's foreground (currentColor), so hover / pressed / disabled recolor
//! them with the frame. Styles in styles.yss, tests in mod.zig.
const ui = @import("../../ui.zig");
const core = @import("../../core.zig");
const S = @import("styles.yss");
const ControlShell = @import("../control_shell/mod.zig").ControlShell;

/// Button semantics: name taken from a11yLabel, else label (falls back to child text if neither),
/// disabled, loading (busy)
fn a11yOf(name: []const u8, text: []const u8, disabled: bool, loading: bool) ui.A11yProps {
    const resolved = if (name.len > 0) name else text;
    return .{ .role = .button, .label = if (resolved.len > 0) resolved else null, .disabled = disabled, .busy = loading };
}

/// Button: W.Button(.{ .label = "Save", .disabled = ui.not(dirty), .on_click = cx.on(S, s, S.save)
/// }).
/// label / variant / size / pill / iconOnly / block / loading / disabled can come from signals;
/// disabled or loading suppresses click response, loading shows the ring and hides the glyph.
/// Hover / pressed (held with pointer still inside) / focus resolve on the shell's node.
/// baseStyle / hoverStyle / pressedStyle merge into the tone per state (style is reserved for the
/// root node attrs, an overlay that wins over every state).
/// iconTint overrides the glyph's current color; iconSize its box.
/// onEvent is low-level generic event callback (not called when disabled, called when loading);
/// eventContext is its context.
/// a11yLabel names the button for assistive tech without rendering text (icon-only buttons).
pub fn Button(
    label: Text = "",
    variant: S.ButtonVariant = .primary,
    size: S.ButtonSize = .md,
    pill: bool = false,
    iconOnly: bool = false,
    loading: bool = false,
    disabled: bool = false,
    focusRing: ui.FocusRingConfig = .{},
    block: bool = false,
    onClick: ?Handler(void) = null,
    icon: ?u32 = null,
    iconAsset: ?ui.SvgAsset = null,
    iconSize: ?f32 = null,
    iconTint: ?ui.Color = null,
    onEvent: ?core.GenericEventCallback = null,
    eventContext: ?*anyopaque = null,
    baseStyle: core.StyleOverride = .{},
    hoverStyle: ?core.StyleOverride = null,
    pressedStyle: ?core.StyleOverride = null,
    a11yLabel: []const u8 = "",
) View {
    const has_svg = computed(iconAsset != null);
    const has_texture = computed(iconAsset == null and icon != null);
    const has_glyph = computed(iconAsset != null or icon != null or loading);
    const leading = computed(!iconOnly and has_glyph and label.len != 0);
    const shows_label = computed(label.len != 0 or !has_glyph);
    const root = computed(S.rootStyle(.{ .block = block, .icon_only = iconOnly, .base = baseStyle, .hover = hoverStyle, .pressed = pressedStyle }));
    const tier = computed(S.Label{ .size = size, .font_size = baseStyle.font_size });
    const semantics = computed(a11yOf(a11yLabel, label, disabled, loading));
    const focus_ring = computed(@as(?ui.FocusRingConfig, focusRing));
    return (
        <ControlShell
            tag={.button}
            variant={variant}
            size={size}
            pill={pill}
            iconOnly={iconOnly}
            leadingIcon={leading}
            iconFit={.glyph}
            disabled={disabled}
            focusable={!disabled}
            focusRing={focus_ring}
            onClick={if (!loading) onClick}
            onEvent={onEvent}
            eventContext={eventContext}
            rootStyle={root}
            contentStyle={.{ .width = .{ .fit = .{} } }}
            iconVisible={has_glyph}
            contentVisible={shows_label}
            a11y={semantics}
            icon={
                <box style={S.glyph_stack}>
                    {if (has_svg) <icon style={S.glyph.of(.{ .size = iconSize, .tier = size })} tint={ui.view.tintBy(iconTint, S.glyphTint)} visible={!loading} src={iconAsset} />}
                    {if (has_texture) <image style={S.glyph.of(.{ .size = iconSize, .tier = size })} tint={ui.view.tintBy(iconTint, S.glyphTint)} visible={!loading} src={icon} />}
                    {if (loading) <box style={S.ring_box}><canvas style={S.ring_canvas} draw={S.drawRing} data={size} animate={ui.view.LoopPeriod{ .period_ms = S.ring_loop_ms }} /></box>}
                </box>
            }
            content={<text style={ui.view.styleBy(tier, S.label)}>{label}</text>}
        />
    );
}
