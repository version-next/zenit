//
// `fingerprint` is the stable package identity used by Zig's package manager.
// Do NOT regenerate it on releases — downstream consumers' caches are keyed
// off this value. Bump `version` only.
.{
    .name = .zenit,
    .version = "0.1.0-alpha",
    .fingerprint = 0xd8a68ba39878e4d7,
    .minimum_zig_version = "0.17.0",

    .dependencies = .{
        // Built separately by the zls/dev-tools steps; UI consumers need no editor dependencies.
        .zls = .{ .path = "vendor/zls", .lazy = true },
    },

    // paths is include-only (Zig has no exclude form), so docs are listed file-by-file rather
    // than wholesale. Everything not named here (internal planning notes in docs/internal/,
    // release-process checklists, roadmap and bug ledger) stays in the repo but does NOT ship
    // in the package tarball: consumers get reference docs, not our process.
    //
    // Paid icons live in the internal checkout's top-level private/, deliberately not in this
    // allowlist, so the Zig fetch/package payload has only Lucide. The public Git source export
    // must still exclude all of private/; scripts/check_oss_icon_license.sh enforces fail-closed.
